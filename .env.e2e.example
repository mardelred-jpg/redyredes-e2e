# ── RedyRedes E2E — Environment Configuration ──────────────────
# Copy this file to .env.e2e and fill in your values.
# NEVER commit .env.e2e to git.

# Service URLs
E2E_JOIN_URL=https://join.redyredes.com
E2E_DASHBOARD_URL=https://dashboard.redyredes.com
E2E_API_URL=https://api.redyredes.com

# Email domain for E2E test users (used for filtering in Clerk + DB cleanup)
E2E_EMAIL_DOMAIN=e2e-test.redyredes.com

# Database (same Neon DB as redyredes-core)
DATABASE_URL=postgresql://...

# Clerk
CLERK_SECRET_KEY=sk_test_...

# Clerk Testing Token (enables fast auth bypass in PAT-001B)
# Generate from: https://clerk.com/docs/testing/playwright
# Set in CI as a secret. Leave empty to fall back to UI interaction.
CLERK_TESTING_TOKEN=

# Stripe (test mode only — for future PAT-002)
STRIPE_SECRET_KEY=sk_test_...

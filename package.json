{
  "name": "redyredes-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "RedyRedes E2E validation platform — Customer Journey tests (PAT-001B, PAT-001C, PAT-002...)",
  "scripts": {
    "build:check": "tsc --noEmit",
    "e2e:pat001b": "playwright test e2e/pat-001b.spec.ts",
    "e2e:pat001b:headed": "playwright test e2e/pat-001b.spec.ts --headed",
    "e2e:pat001b:debug": "playwright test e2e/pat-001b.spec.ts --debug",
    "e2e:pat001c": "playwright test e2e/pat-001c.spec.ts",
    "e2e:pat001c:headed": "playwright test e2e/pat-001c.spec.ts --headed",
    "e2e:all": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:trace": "playwright show-trace test-results/trace.zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0"
  }
}
